# Database Configuration
DB_HOST=157.180.28.78
DB_PORT=3306
DB_NAME=tbatch2_db
DB_USER=tbatch2
DB_PASSWORD=tbatch2

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=Vendor Intelligence API
VERSION=1.0.0
DESCRIPTION=Vendor Performance Tracking and Selection System

# Performance Scoring Weights (must sum to 1.0)
WEIGHT_ONTIME_DELIVERY=0.30
WEIGHT_COST_COMPETITIVENESS=0.25
WEIGHT_EXCEPTION_RATE=0.20
WEIGHT_CAPACITY_UTILIZATION=0.15
WEIGHT_POD_COMPLIANCE=0.10

# Environment
ENVIRONMENT=development
DEBUG=true